# Copy this file to .env and fill in what you need. Everything is optional except for real Gmail access.

# --- Gmail (see README, "Connect your real Gmail") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud exactly:
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional extra Gmail search filter applied on every sync:
# GMAIL_EXTRA_QUERY=-category:promotions -category:social

# --- AI reading (optional; the rule-based reader works without it) ---
# Option 1: Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Option 2: any OpenAI-compatible server, e.g. a local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# LLM_PROVIDER=auto   # auto | anthropic | openai_compat | none

# --- Daily digest by email (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# DIGEST_TO=you@gmail.com

# --- Server ---
# PORT=8000
# AUTO_SYNC_MINUTES=30      # 0 turns off automatic Gmail checks
# REMINDER_CHECK_MINUTES=15
# TOKEN_ENCRYPTION_KEY=     # optional; otherwise a key file is created in data/
